# Your shop's settings. Never commit these.
config.json

# YOUR RUNNING LOG. STATUS.md holds your real weekly figures, your bank
# balances, your debt and your own notes. It is the same shape of private data
# as config.json. If you fork this repo, this line is what stops you publishing
# your shop's finances by accident. Do not remove it.
STATUS.md
STATUS-*.md

# Credentials. These should live OUTSIDE the repo entirely, but block them here
# too in case someone puts them in by mistake.
.env
*.env
.cpts-secrets/
**/token.txt
**/*secret*
**/*credential*

# API audit logs contain your shop id and request history.
logs/
*.jsonl

# Anything staged for a real week.
week-*.json
week-*.txt
scratch/

node_modules/
.DS_Store
Thumbs.db
